# Real Estate Enterprise Command Center Environment Configuration

ENVIRONMENT=production
SECRET_KEY=replace-with-a-64-character-cryptographic-random-secret
CRM_WEBHOOK_SECRET=replace-with-a-32-character-webhook-hmac-secret

# Centralized PostgreSQL Database
DATABASE_URL=postgresql://app:ChangeThisPasswordInProd!@localhost:5432/platform
DB_PASSWORD=ChangeThisPasswordInProd!

# Redis Cache & Task Queue
REDIS_URL=redis://localhost:6379/0

# Keycloak OIDC Authentication (Optional SSO)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=realestate-enterprise
KEYCLOAK_CLIENT_ID=command-center

# AI Gateway / LLM Integration (OpenAI-compatible)
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-openai-or-compatible-api-key
AI_MODEL=gpt-4o-mini

# Initial Seed Password for Synthetic Accounts
SEED_PASSWORD=AdminPass@2026
